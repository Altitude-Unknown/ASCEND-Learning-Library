---
layout: layouts/base.njk
---
<div class="container">
<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">{{ section.title }}</span></nav>
<header class="section-hero"><span class="eyebrow">LEARN</span><div class="section-hero-row"><div><h1>{% if section.id == 'part107' %}FAA Part 107 Commercial Remote Pilot Certification Training{% else %}{{ section.title }}{% endif %}</h1><p class="lead">{{ section.description }}</p></div><span class="section-symbol" aria-hidden="true"><svg><use href="#i-{{ section.icon }}"/></svg></span></div></header>
{% if section.courses.length %}<section class="section-block section-courses" aria-labelledby="{{ section.id }}-courses"><div class="section-heading"><div><span class="eyebrow">Start here</span><h2 id="{{ section.id }}-courses">Get certified first</h2></div></div><div class="module-grid">{% for course in section.courses %}<a class="module-card course-card" href="{{ course.url }}"><div><h3>{{ course.title }}</h3><p>{{ course.description }}</p></div><svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>{% endfor %}</div></section>{% endif %}
{% if section.overview.length %}<div class="prose project-intro">{% for paragraph in section.overview %}<p>{{ paragraph }}</p>{% endfor %}</div>{% endif %}
{% if section.contextLinks.length %}<div class="project-links">{% for link in section.contextLinks %}<a class="button outline" href="{{ link.url }}">{{ link.title }} →</a>{% endfor %}</div>{% endif %}
{% if section.id == 'part107' %}
{% include "components/part107-course.njk" %}
{% elif section.id == 'videos' or section.id == 'downloads' %}
 {% if section.id == 'videos' %}{% set items = collections.resources | byKind('Video') %}{% else %}{% set items = collections.resources | downloadable %}{% endif %}
 <p class="notice">Available resources include file links. Items marked “Planned” are future additions.{% if section.id == 'downloads' %} The library supports PDF, PPTX, DOCX, STL, DXF, STEP, ZIP, code, and datasets.{% endif %}</p>
 {% include "components/browser.njk" %}
{% else %}
{% if section.projects.length %}<section class="section-block"><div class="section-heading"><h2>Aircraft projects</h2></div><div class="module-grid">{% for project in section.projects %}<a class="module-card" href="{{ project.url }}"><div><h3>{{ project.title }}</h3><p>{{ project.description }}</p></div><svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>{% endfor %}</div></section>{% endif %}
<section class="section-block"><div class="section-heading"><div><span class="eyebrow">{{ section.tagline }}</span><h2>Topics to explore</h2></div><span class="count-label">EXPLORE BY TOPIC</span></div><div class="subtopic-grid">{% for sub in section.subsections %}<section class="subtopic" id="{{ sub.slug }}"><span class="small muted">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span><h3>{{ sub.title }}</h3>{% if sub.resourceIds.length %}{% for resource in collections.resources | related(sub.resourceIds) %}<p><a href="{{ resource.url }}">{{ resource.data.title }} →</a></p>{% endfor %}{% else %}{% if sub.description %}<p>{{ sub.description }}</p>{% for link in sub.links %}<p><a href="{{ link.url }}">{{ link.title }} →</a></p>{% endfor %}{% else %}<p>Resources for this topic are being prepared.</p><a href="/library/?topic={{ section.id }}">Browse {{ section.title }} resources <span aria-hidden="true">→</span></a>{% endif %}{% endif %}</section>{% endfor %}</div></section>
{% set topicResources = collections.resources | byTopic(section.id) %}{% if topicResources.length %}<section class="section-block"><div class="section-heading"><h2>From the resource library</h2><a href="/library/?topic={{ section.id }}">View all →</a></div><div class="resource-grid">{% for resource in topicResources %}{% include "components/card.njk" %}{% endfor %}</div></section>{% endif %}
{% endif %}
</div>
