---
layout: layouts/base.njk
---
<div class="container">
<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">{{ section.title }}</span></nav>
<header class="section-hero"><span class="eyebrow">EXPLORE THE LIBRARY</span><div class="section-hero-row"><div><h1>{{ section.title }}</h1><p class="lead">{{ section.description }}</p></div><span class="section-symbol" aria-hidden="true"><svg><use href="#i-{{ section.icon }}"/></svg></span></div></header>
{% if section.id == 'part107' %}
<div class="section-heading"><div><span class="eyebrow">A PATH FROM CURIOSITY TO CONFIDENCE</span><h2>Your Part 107 learning path</h2><p>Start at the beginning, or explore the topic you need.</p></div><span class="count-label">09 MODULES</span></div>
<div class="module-grid">{% for m in collections.modules %}<a class="module-card{% if m.data.order == 3 %} featured-module{% endif %}" href="{{ m.url }}"><span class="module-number">0{{ m.data.order }}</span><div><h3>{{ m.data.title }}</h3><p>{{ m.data.description }}</p></div><svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg>{% if m.data.order == 3 %}<span class="module-badge">EXPLORE THE EXAMPLE MODULE</span>{% endif %}</a>{% endfor %}</div>
{% include "components/practice.njk" %}
{% elif section.id == 'videos' or section.id == 'downloads' %}
 {% if section.id == 'videos' %}{% set items = collections.resources | byKind('Video') %}{% else %}{% set items = collections.resources | downloadable %}{% endif %}
 <p class="notice">These are example records. Files and videos will be connected as reviewed materials are added.{% if section.id == 'downloads' %} The library supports PDF, PPTX, DOCX, STL, DXF, STEP, ZIP, code, and datasets.{% endif %}</p>
 {% include "components/browser.njk" %}
{% else %}
<section class="section-block"><div class="section-heading"><div><span class="eyebrow">{{ section.tagline }}</span><h2>Topics to explore</h2></div><span class="count-label">MATERIALS IN DEVELOPMENT</span></div><div class="subtopic-grid">{% for sub in section.subsections %}<section class="subtopic" id="{{ sub.slug }}"><span class="small muted">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span><h3>{{ sub.title }}</h3><p>Resources for this topic are being prepared.</p><a href="/library/?topic={{ section.id }}">Browse {{ section.title }} resources <span aria-hidden="true">→</span></a></section>{% endfor %}</div></section>
{% set topicResources = collections.resources | byTopic(section.id) %}{% if topicResources.length %}<section class="section-block"><div class="section-heading"><h2>From the resource library</h2><a href="/library/?topic={{ section.id }}">View all →</a></div><div class="resource-grid">{% for resource in topicResources %}{% include "components/card.njk" %}{% endfor %}</div></section>{% endif %}
{% endif %}
</div>
