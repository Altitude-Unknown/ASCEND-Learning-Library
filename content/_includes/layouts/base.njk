<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
<meta name="description" content="{{ description or site.description }}">
<meta name="theme-color" content="#102f3a">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/assets/site.css">
{% if teamsMap %}<link rel="stylesheet" href="/assets/data/dist/maplibre.css"><link rel="stylesheet" href="/assets/teams/teams.css"><script type="module" src="/assets/data/dist/teams-map.js"></script>{% endif %}
{% if dataApp %}<link rel="stylesheet" href="/assets/data/dist/maplibre.css"><link rel="stylesheet" href="/assets/data/data.css"><script type="module" src="/assets/data/dist/{{ dataApp }}.js"></script>{% endif %}
{% if practiceApp %}<link rel="stylesheet" href="/assets/practice/app.css"><script type="module" src="/assets/practice/app.js"></script>{% endif %}
{% if searchPage %}<link rel="stylesheet" href="/pagefind/pagefind-ui.css"><script src="/pagefind/pagefind-ui.js" defer></script>{% endif %}
<script src="/assets/site.js" defer></script>
</head>
<body>
<a class="skip-link" href="#main">Skip to main content</a>
{% include "components/icons.njk" %}
{% if site.prototype %}<div class="prototype-bar">PREVIEW <span>ASCEND is being built for teams starting in 2027. Explore what’s here; more is added regularly.</span></div>{% endif %}
{% set learnActive = section or page.url in (siteNavigation.learn | urls) or page.url.startsWith('/uas/') or page.url.startsWith('/resources/') or page.url.startsWith('/part107/') %}
{% set dataActive = page.url.startsWith('/data/') %}
{% set aboutActive = page.url == '/accessibility/' or page.url in (programNavigation | urls) %}
<header class="site-header" data-pagefind-ignore>
 <div class="header-inner">
 <a class="brand" href="/" aria-label="ASCEND home"><img class="brand-logo" src="/assets/ascend-logo.jpg" alt="" width="66" height="66"><span><strong>ASCEND</strong></span></a>
 <nav aria-label="Primary navigation" class="desktop-nav">
 <details class="nav-menu"><summary{% if learnActive %} class="is-current"{% endif %}>Learn <span aria-hidden="true">▾</span></summary><div class="nav-panel">{% for item in siteNavigation.learn %}<a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.title }}</a>{% endfor %}</div></details>
 <details class="nav-menu"><summary{% if dataActive %} class="is-current"{% endif %}>Data <span aria-hidden="true">▾</span></summary><div class="nav-panel">{% for item in siteNavigation.data %}<a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.title }}</a>{% endfor %}</div></details>
 <a href="/community/"{% if page.url == '/community/' %} aria-current="page"{% endif %}>Community</a>
 <details class="nav-menu"><summary{% if aboutActive %} class="is-current"{% endif %}>About <span aria-hidden="true">▾</span></summary><div class="nav-panel">{% for item in programNavigation %}<a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.title }}</a>{% endfor %}<a href="/accessibility/"{% if page.url == '/accessibility/' %} aria-current="page"{% endif %}>Accessibility & privacy</a></div></details>
 </nav>
 <div class="header-actions"><a class="search-link" href="/search/" aria-label="Search"><svg class="icon" aria-hidden="true"><use href="#i-search"/></svg><span>Search</span></a><a class="search-link member-link" href="/data/team/"{% if page.url == '/data/team/' %} aria-current="page"{% endif %}>Member login</a>
 <details class="topic-menu"><summary>Menu <span aria-hidden="true">＋</span></summary><nav aria-label="Site menu"><h2>Learn</h2>{% for item in siteNavigation.learn %}<a href="{{ item.url }}">{{ item.title }}</a>{% endfor %}<h2>Data</h2>{% for item in siteNavigation.data %}<a href="{{ item.url }}">{{ item.title }}</a>{% endfor %}<h2>Community</h2><a href="/community/">Community</a><h2>About</h2>{% for item in programNavigation %}<a href="{{ item.url }}">{{ item.title }}</a>{% endfor %}<a href="/accessibility/">Accessibility & privacy</a></nav></details></div>
 </div>
</header>
<main id="main" tabindex="-1"{% if page.url != '/search/' and page.url != '/404.html' %} data-pagefind-body{% endif %}>
{{ content | safe }}
</main>
<footer class="site-footer" data-pagefind-ignore>
 <div class="container footer-grid"><div><a class="footer-brand" href="/">ASCEND</a><p>Ideas for college teams.<br>Tools for the field.<br>Room to explore.</p></div><div><h2>Learn</h2>{% for item in siteNavigation.learn %}<a href="{{ item.url }}">{{ item.title }}</a>{% endfor %}</div><div><h2>Data & community</h2>{% for item in siteNavigation.data %}<a href="{{ item.url }}">{{ item.title }}</a>{% endfor %}<a href="/community/">Community</a><h2 class="footer-subheading">Browse by format</h2><a href="/fabrication/">CAD & Fabrication</a><a href="/videos/">Videos</a><a href="/downloads/">Downloads</a></div><div><h2>About ASCEND</h2>{% for item in programNavigation %}<a href="{{ item.url }}">{{ item.title }}</a>{% endfor %}<p>ASCEND is a NASA-funded STEM project for community college and university teams.</p><p class="footer-fine">This site does not imply NASA endorsement. No NASA insignia is used.</p><a href="/accessibility/">Accessibility & privacy</a></div></div>
 <div class="container footer-bottom"><span>© {{ '' | year }} ASCEND</span><span>Open to explore. Sign-in is only for member tools.</span><a href="#main">Back to top ↑</a></div>
</footer>
</body></html>
