<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
<meta name="description" content="{{ description or site.description }}">
<meta name="theme-color" content="#102f3a">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/assets/site.css">
{% if searchPage %}<link rel="stylesheet" href="/pagefind/pagefind-ui.css"><script src="/pagefind/pagefind-ui.js" defer></script>{% endif %}
<script src="/assets/site.js" defer></script>
</head>
<body>
<a class="skip-link" href="#main">Skip to main content</a>
{% include "components/icons.njk" %}
{% if site.prototype %}<div class="prototype-bar">PREVIEW EDITION <span>Explore books, presentations, and build files. Future resources are marked “Planned.”</span></div>{% endif %}
<header class="site-header" data-pagefind-ignore>
 <div class="header-inner">
 <a class="brand" href="/" aria-label="ASCEND Learning Library home"><img class="brand-logo" src="/assets/ascend-logo.jpg" alt="" width="66" height="66"><span><strong>ASCEND</strong><small>LEARNING LIBRARY</small></span></a>
 <nav aria-label="Primary navigation" class="desktop-nav">
 <a href="/library/"{% if page.url == '/library/' %} aria-current="page"{% endif %}>Resource library</a>
 <a href="/part107/"{% if topic == 'part107' or section.id == 'part107' %} aria-current="page"{% endif %}>FAA Part 107</a>
 <a href="/teachers/"{% if page.url == '/teachers/' %} aria-current="page"{% endif %}>Faculty & Pods</a>
 </nav>
 <div class="header-actions"><a class="search-link" href="/search/" aria-label="Search"><svg class="icon" aria-hidden="true"><use href="#i-search"/></svg><span>Search</span></a>
 <details class="topic-menu"><summary>Explore <span aria-hidden="true">＋</span></summary><nav aria-label="Explore all topics">{% for item in programNavigation %}<a href="{{ item.url }}">{{ item.title }}</a>{% endfor %}<a href="/library/">All resources</a>{% for t in topics %}<a href="/{{ t.id }}/">{{ t.title }}</a>{% endfor %}</nav></details></div>
 </div>
</header>
<main id="main" tabindex="-1"{% if page.url != '/search/' and page.url != '/404.html' %} data-pagefind-body{% endif %}>
{{ content | safe }}
</main>
<footer class="site-footer" data-pagefind-ignore>
 <div class="container footer-grid"><div><a class="footer-brand" href="/">ASCEND<span>LEARNING LIBRARY</span></a><p>Ideas for college teams.<br>Tools for the field.<br>Room to explore.</p></div><div><h2>Explore</h2><a href="/part107/">FAA Part 107</a><a href="/uas/">UAS</a><a href="/air-quality/">Air Quality</a><a href="/ballooning/">High-Altitude Ballooning</a></div><div><h2>Find resources</h2><a href="/fabrication/">CAD & Fabrication</a><a href="/teachers/">Faculty & Pod Resources</a><a href="/videos/">Videos</a><a href="/downloads/">Downloads</a></div><div><h2>About ASCEND</h2>{% for item in programNavigation %}<a href="{{ item.url }}">{{ item.title }}</a>{% endfor %}<p>A public educational resource for ASCEND, a NASA-funded STEM project for community college and university teams.</p><p class="footer-fine">This library does not imply NASA endorsement. No NASA insignia is used.</p><a href="/accessibility/">Accessibility & use</a></div></div>
 <div class="container footer-bottom"><span>© {{ '' | year }} ASCEND Learning Library</span><span>Open to explore. No account required.</span><a href="#main">Back to top ↑</a></div>
</footer>
</body></html>
