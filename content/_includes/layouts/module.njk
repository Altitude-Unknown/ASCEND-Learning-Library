---
layout: layouts/base.njk
---
<div class="container">
<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/part107/">FAA Part 107</a><span aria-hidden="true">/</span><span aria-current="page">{{ title }}</span></nav>
<div class="module-layout">
<aside class="module-sidebar" data-pagefind-ignore><p class="eyebrow">BROWSE PART 107</p><nav aria-label="Part 107 topics">{% for m in collections.modules %}<a href="{{ m.url }}"{% if m.url == page.url %} aria-current="page"{% endif %}>{{ m.data.title }}</a>{% endfor %}</nav><a class="sidebar-back" href="/part107/">← Part 107 overview</a></aside>
<article class="module-content">
 <span class="eyebrow" data-pagefind-filter="Topic:FAA Part 107">FAA PART 107 / REFERENCE TOPIC</span><h1>{{ title }}</h1><p class="lead">{{ description }}</p>
 <div class="meta-line"><span class="pill">Reference topic</span><span>Browse as needed</span><span>{{ status }}</span></div>
 {% if status == 'Prototype' %}<div class="notice"><strong>Content preview</strong> Materials for this topic are still being prepared.</div>{% endif %}
 <div class="prose">{{ content | safe }}</div>
 {% if objectives.length %}<section class="objectives"><span class="eyebrow">LEARN WITH PURPOSE</span><h2>Learning objectives</h2><p class="small muted">Topics this resource will help you explore.</p><ol>{% for objective in objectives %}<li>{{ objective }}</li>{% endfor %}</ol></section>{% endif %}
 <section class="section-block"><div class="section-heading"><div><span class="eyebrow">READ · WATCH · EXPLORE</span><h2>Related resources</h2></div></div>
 {% set linked = collections.resources | related(resourceIds) %}
 {% if linked.length %}<div class="resource-grid two">{% for resource in linked %}{% include "components/card.njk" %}{% endfor %}</div>{% else %}<div class="empty-state"><h3>Materials are being prepared</h3><p>This topic will bring together readings, presentations, videos, and student materials.</p><a href="/library/">Browse resources →</a></div>{% endif %}
 </section>

 {% if order == 9 %}{% include "components/practice.njk" %}{% endif %}
 <nav class="module-next" aria-label="More resources"><a href="/part107/">Browse all Part 107 topics →</a><a href="/library/">Browse the resource library →</a></nav>
</article></div></div>
