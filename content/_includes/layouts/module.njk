---
layout: layouts/base.njk
---
<div class="container">
<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/part107/">FAA Part 107</a><span aria-hidden="true">/</span><span aria-current="page">{{ title }}</span></nav>
<div class="module-layout">
<aside class="module-sidebar" data-pagefind-ignore><p class="eyebrow">BROWSE PART 107</p><nav aria-label="Part 107 topics">{% for m in collections.modules %}<a href="{{ m.url }}"{% if m.url == page.url %} aria-current="page"{% endif %}>{{ m.data.title }}</a>{% endfor %}</nav><a class="sidebar-back" href="/part107/">← Part 107 overview</a></aside>
<article class="module-content">
{% if courseOrder %}{% set courseUnit = part107Course.units[courseOrder - 1] %}{% endif %}
 <span class="eyebrow" data-pagefind-filter="Topic:FAA Part 107">FAA PART 107 / {% if courseOrder %}UNIT {{ courseOrder }} OF 5{% else %}COURSE REFERENCE{% endif %}</span><h1>{{ title }}</h1><p class="lead">{{ description }}</p>
 <div class="meta-line"><span class="pill">{% if courseOrder %}Unit {{ courseOrder }} of 5{% else %}Course reference{% endif %}</span><span>{% if courseOrder %}Watch · Read · Apply · Check{% else %}Use alongside the learning path{% endif %}</span><span>{{ status }}</span></div>
{% if courseOrder %}<section class="objectives"><h2>What you will learn</h2><ul>{% for outcome in courseUnit.outcomes %}<li>{{ outcome }}</li>{% endfor %}</ul></section>{% endif %}
 {% if status == 'Prototype' %}<div class="notice"><strong>Content preview</strong> Materials for this topic are still being prepared.</div>{% endif %}
 <div class="prose">{{ content | safe }}</div>
 {% if objectives.length %}<section class="objectives"><span class="eyebrow">LEARN WITH PURPOSE</span><h2>Learning objectives</h2><p class="small muted">Topics this resource will help you explore.</p><ol>{% for objective in objectives %}<li>{{ objective }}</li>{% endfor %}</ol></section>{% endif %}
 <section class="section-block"><div class="section-heading"><div><span class="eyebrow">READ · WATCH · EXPLORE</span><h2>Related resources</h2></div></div>
 {% set linked = collections.resources | related(resourceIds) %}
 {% if linked.length %}<div class="resource-grid two">{% for resource in linked %}{% include "components/card.njk" %}{% endfor %}</div>{% else %}<div class="empty-state"><h3>Materials are being prepared</h3><p>This topic will bring together readings, presentations, videos, and student materials.</p><a href="/library/">Browse resources →</a></div>{% endif %}
 </section>

 {% if order == 9 and not practiceApp %}{% include "components/practice.njk" %}{% endif %}
 {% if courseOrder %}
 <section class="quiz-panel"><div><h2>Check your understanding</h2><p>Choose 10 questions or the full {{ courseUnit.title }} bank. Review the concepts behind missed answers before moving on.</p><div class="project-links"><a class="button" href="/part107/practice-tests/?bank={{ courseUnit.bank | urlencode }}">Take the unit quiz</a><a href="/part107/practice-tests/?bank={{ courseUnit.bank | urlencode }}&amp;count=all">Practice the full unit bank →</a></div></div></section>
 <nav class="module-next" aria-label="Course sequence">
 {% if courseOrder > 1 %}{% set previousUnit = part107Course.units[courseOrder - 2] %}<a href="{{ previousUnit.url }}">← Unit {{ previousUnit.number }}: {{ previousUnit.title }}</a>{% else %}<a href="/part107/">← Course overview</a>{% endif %}
 {% if courseOrder < 5 %}{% set nextUnit = part107Course.units[courseOrder] %}<a href="{{ nextUnit.url }}">Next: Unit {{ nextUnit.number }} — {{ nextUnit.title }} →</a>{% else %}<a href="/part107/practice-tests/?bank=mixed">Next: Comprehensive practice exam →</a>{% endif %}
 </nav>
 {% else %}<nav class="module-next" aria-label="More resources"><a href="/part107/">Follow the Part 107 learning path →</a><a href="/library/">Browse the resource library →</a></nav>{% endif %}
</article></div></div>
