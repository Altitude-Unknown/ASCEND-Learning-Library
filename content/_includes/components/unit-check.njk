<section class="section-block unit-study-step unit-check" id="check" aria-labelledby="check-heading">
  {% if courseUnit.reviewQuestions.length %}
  <div class="section-heading"><div><span class="eyebrow">STEP 4 · CHECK & REVISIT</span><h2 id="check-heading">Check your understanding</h2><p>Answer each review question in your own words first, then open the answer to compare. Return to the reading for any question you missed.</p></div></div>
  <ol class="review-questions">
    {% for number in courseUnit.reviewQuestions %}{% set item = course.reviewQuestions[number] %}
    <li><p>{{ item.question }}</p><details><summary>Show the answer<span class="visually-hidden"> to review question {{ number }}</span></summary><p>{{ item.answer }}</p></details></li>
    {% endfor %}
  </ol>
  <p class="small muted">Review questions and answers are from {{ course.chapterTitle }} of the lab manual, where they are numbered {% for number in courseUnit.reviewQuestions %}{{ number }}{% if not loop.last %}, {% endif %}{% endfor %}.</p>
  {% endif %}
  {% if courseUnit.skills.length %}
  <div class="section-heading"><div>{% if not courseUnit.reviewQuestions.length %}<span class="eyebrow">STEP 4 · CHECK & REVISIT</span>{% endif %}<h2 id="{% if courseUnit.reviewQuestions.length %}skills-heading{% else %}check-heading{% endif %}">Skills checksheet</h2><p>By the end of the course you should be able to do each of these. Ask your instructor to sign off each skill when you demonstrate it.</p></div></div>
  <ul class="skills-checklist">{% for skill in courseUnit.skills %}<li>{{ skill }}</li>{% endfor %}</ul>
  {% endif %}
</section>
