{
  "name": "ascend-learning-library",
  "version": "0.1.0",
  "private": true,
  "description": "A public, static STEM resource library for ASCEND",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:data && eleventy && pagefind --site _site",
    "dev": "npm run build:data && eleventy --serve",
    "preview": "node scripts/preview.mjs",
    "check": "node scripts/check-part107-textbook.mjs && node scripts/check-site.mjs && node scripts/check-materials.mjs && node scripts/check-resource-templates.mjs && node scripts/check-practice.mjs && npm run test:data && npm run test:auth",
    "test": "npm run build && npm run check",
    "test:browser": "playwright test",
    "build:data": "node scripts/data-explorer/build.mjs",
    "test:data": "node --test data-api/tests/*.test.js",
    "test:auth": "node --test auth-proxy/tests/*.test.js",
    "check:auth": "wrangler deploy --dry-run --config auth-proxy/wrangler.jsonc",
    "check:live-sign-in": "node scripts/data-explorer/check-live-sign-in.mjs",
    "check:auth-proxy": "node scripts/data-explorer/check-auth-proxy.mjs",
    "dev:api": "wrangler dev --config data-api/wrangler.jsonc",
    "check:api": "wrangler deploy --dry-run --config data-api/wrangler.jsonc",
    "demo:data": "node scripts/data-explorer/generate-demo.mjs",
    "test:integration": "node data-api/tests/integration.mjs",
    "format:data": "prettier --write \"src/data/*.js\" \"data-api/src/*.js\" \"data-api/tests/*.{js,mjs}\" \"scripts/data-explorer/*.mjs\" content/_data/dataExplorer.js tests/data-explorer.spec.js public/assets/data/data.css"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "pagefind": "^1.4.0",
    "prettier": "^3.9.9",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "maplibre-gl": "^6.12.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1"
  }
}
